/dts-v1/;
/plugin/;

#include <dt-bindings/display/media-bus-format.h>

&spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&rm_io4_spi0_clk &rm_io5_spi0_mosi>;
	spi-3wire;

	panel: panel@0 {
		compatible = "simple-panel-spi";
		reg = <0>;
		spi-max-frequency = <3000000>;
		spi-3wire;
		bus-format = <MEDIA_BUS_FMT_RGB666_1X18>;
		status = "okay";

		display-timings {
			native-mode = <&rgb_timing>;

			rgb_timing: timing0 {
				clock-frequency = <30000000>;
				hactive = <360>;
				vactive = <960>;
				hback-porch = <20>;
				hfront-porch = <20>;
				vback-porch = <20>;
				vfront-porch = <32>;
				hsync-len = <8>;
				vsync-len = <2>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

/* PLACEHOLDER_INIT_SEQ */
	};
};
