/dts-v1/;
/plugin/;

#include <dt-bindings/display/media-bus-format.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/rockchip.h>

&{/} {
	spi_panel: spi-panel {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		gpio-sck = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;
		gpio-mosi = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
		num-chipselects = <0>;
		status = "okay";

		panel: panel@0 {
			compatible = "simple-panel-spi";
			reg = <0>;
			spi-max-frequency = <100000>;
			bus-format = <MEDIA_BUS_FMT_RGB666_1X18>;
			status = "okay";

			panel-init-sequence = [
			00 00 01 F0
			01 00 05 55 AA 52 08 00
			00 00 01 F6
			01 00 02 5A 87
			00 00 01 C1
			01 00 01 3F
			00 00 01 CD
